variable model index tensorial-metal.ptb
variable newton_pair index on
variable backend index cpu

units           metal
atom_style      atomic
boundary        p p p
newton ${newton_pair}

# diamond Si, 4x4x4 cells = 512 atoms, box ~21.7 A
lattice         diamond 5.431
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 28.0855

pair_style chemtrain ${backend}
pair_coeff * * ${model}

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

velocity        all create 300.0 12345 dist gaussian
fix             1 all nve
timestep        0.001

thermo          10
thermo_style    custom step temp pe ke etotal press

compute pe_atom all pe/atom
dump 1 all custom 10 dump.pe id type x y z c_pe_atom

run             100
