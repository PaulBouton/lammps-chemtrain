variable model index lennard_jones_sparse.ptb
variable newton_pair index on
variable backend index cuda

units lj
atom_style atomic
boundary p p p
newton ${newton_pair}

# Build a periodic FCC Lennard-Jones system.
lattice fcc 0.8442
region box block 0 2 0 2 0 2
create_box 1 box
create_atoms 1 box
mass 1 1.0

pair_style chemtrain ${backend}
pair_coeff * * ${model}

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

velocity all create 1.0 4928459 mom yes rot yes dist gaussian
fix integration all nve

# Record potential, kinetic, and total energy after every integration step.
variable potential equal pe
variable kinetic equal ke
variable total equal etotal
fix energy all ave/time 1 1 1 v_potential v_kinetic v_total file energy-bulk.dat

thermo 1
thermo_style custom step atoms pe ke etotal press
thermo_modify norm no
timestep 0.0025
run 0

# Track the maximum total-energy drift per atom during the NVE trajectory.
variable initial_energy equal $(etotal:%.17g)
variable energy_drift equal abs(etotal-v_initial_energy)/atoms
fix drift all vector 1 v_energy_drift
run 20
variable max_energy_drift equal max(f_drift)
print "Maximum energy drift per atom: ${max_energy_drift}"
if "${max_energy_drift} > 1.0e-3" then "quit 1"
