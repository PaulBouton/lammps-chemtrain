Bootstrap: docker
From: ubuntu:26.04

%arguments
    APP_DIR=/usr/local/app/lammps
    PYTHON_VENV_DIR=/usr/local/app/lammps/venv

%files
    ../src              {{ APP_DIR }}/src
    ../chemtrain        {{ APP_DIR }}/chemtrain
    ../tensorial        {{ APP_DIR }}/tensorial
    ../cmake            {{ APP_DIR }}/cmake
    ../bash             {{ APP_DIR }}/bash
    ../python           {{ APP_DIR }}/python
    ../requirements.txt {{ APP_DIR }}/requirements.txt

%environment
    export PATH={{ APP_DIR }}/build:$PATH

%post -c /bin/bash
    shopt -s extglob
    set -e
    export DEBIAN_FRONTEND=noninteractive
    
    source {{ APP_DIR }}/bash/utils.bash

    apt update
    apt install --no-install-recommends -y git build-essential wget libopenmpi-dev openmpi-bin curl software-properties-common cmake

    add-apt-repository -y ppa:deadsnakes/ppa
    apt update
    apt install -y ${python_version} ${python_version}-venv ${python_version}-dev

    cd {{ APP_DIR }}
    bash bash/setup_python_venv.bash {{ PYTHON_VENV_DIR }} cpu

    source {{ PYTHON_VENV_DIR }}/bin/activate

    pip install --upgrade pip

    mkdir -p build && cd build
    cmake ../cmake --preset=chemtrain
    make -j "$(nproc)"
    
    # Cleaning to lighten the image
    apt purge -y git build-essential wget curl software-properties-common cmake libopenmpi-dev ${python_version}-dev
    apt autoclean -y && apt autoremove --purge -y && apt clean -y && apt autopurge -y
    
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /root/.cache

    rm -rf CMakeCache.txt CMakeFiles Makefile cmake_install.cmake
    rm -rf {{ APP_DIR }}/tensorial
    rm -rf {{ APP_DIR }}/chemtrain
    rm -rf {{ APP_DIR }}/cmake
    rm -rf {{ APP_DIR }}/src/!(CHEMTRAIN-DEPLOY)
    rm -rf {{ APP_DIR }}/python/!(model-export)

    pip cache purge
    find {{ PYTHON_VENV_DIR }} -type d -name __pycache__ -prune -exec rm -rf {} +
    find {{ PYTHON_VENV_DIR }} -type d \( -name tests -o -name test \) -prune -exec rm -rf {} +
    find {{ PYTHON_VENV_DIR }} -name '*.a' -delete

%runscript
    #!/bin/bash
    cmd="${1:-}"; [ $# -gt 0 ] && shift
    case "$cmd" in
        lmp)    exec mpirun --use-hwthread-cpus lmp -in "$@" ;;
        export) exec {{ PYTHON_VENV_DIR }}/bin/python {{ APP_DIR }}/python/model-export/export-model.py "$@" ;;
        *)      echo "Unknown command: $cmd" >&2; exit 1 ;;
    esac
