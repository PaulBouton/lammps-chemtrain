Bootstrap: docker
From: ubuntu:26.04

%arguments
    APP_DIR=/usr/local/app/lammps
    PYTHON_VENV_DIR=/usr/local/app/lammps/venv

%files
    ../src          {{ APP_DIR }}/src
    ../chemtrain    {{ APP_DIR }}/chemtrain
    ../tensorial    {{ APP_DIR }}/tensorial
    ../cmake        {{ APP_DIR }}/cmake
    ../bash         {{ APP_DIR }}/bash
    ../python       {{ APP_DIR }}/python
    ../examples/PACKAGES/chemtrain-deploy {{ APP_DIR }}/examples

%environment
    export PATH={{ APP_DIR }}/build:$PATH

%post -c /bin/bash
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt update
    apt install -y make git build-essential wget nano libopenmpi-dev openmpi-bin \
        curl software-properties-common cmake

    add-apt-repository -y ppa:deadsnakes/ppa
    apt update
    apt install -y python3.13 python3.13-venv python3.13-dev

    apt upgrade -y && apt autoremove --purge -y

    cd {{ APP_DIR }}
    bash bash/setup_python_venv.bash {{ PYTHON_VENV_DIR }} cpu

    source {{ PYTHON_VENV_DIR }}/bin/activate

    mkdir -p build && cd build
    cmake ../cmake --preset=chemtrain
    make -j "$(nproc)"

%runscript
    cmd="${1:-}"; [ $# -gt 0 ] && shift
    case "$cmd" in
        lmp)    exec mpirun --use-hwthread-cpus lmp -in "$@" ;;
        export) exec {{ APP_DIR }}/venv/bin/python {{ APP_DIR }}/python/model-export/export-model.py "$@" ;;
        *)      echo "Unknown command: $cmd" >&2; exit 1 ;;
    esac